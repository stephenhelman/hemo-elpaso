# Copy to .env.local for development. Production values live in Vercel (Project > Settings > Environment Variables).
# Never commit real secrets.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://hemoelpaso.org

# --- Email (Resend) ---
RESEND_API_KEY=
# EMAIL_MODE decides whether an email can reach Resend (src/lib/email/mode.ts). Leave it UNSET almost always:
#   (unset)    production (VERCEL_ENV=production) -> "live"; everywhere else -> "capture"
#   capture    never call Resend. Emails are rendered, logged as EmailLog status "captured", and (local dev) written to
#              .email-outbox/*.html so you can open them. This is what local dev, preview deploys and check scripts use.
#   allowlist  send via Resend ONLY to addresses in EMAIL_DEV_ALLOWLIST; everything else is captured.
#   live       send everything. The app REFUSES TO START with "live" unless VERCEL_ENV=production.
# EMAIL_MODE=
# Comma-separated exact addresses (or "@domain.org") for EMAIL_MODE=allowlist, e.g. your own inbox:
# EMAIL_DEV_ALLOWLIST=you@example.com
# Domain of every org mailbox and every "from" address. MUST be the domain verified in Resend.
# Also the only domain the Email Routing settings accept. Default if unset: hemoelpaso.org
NEXT_PUBLIC_EMAIL_DOMAIN=hemoelpaso.org
# Sender for registration/household confirmations and the contact auto-reply. Required in production.
# Must be on NEXT_PUBLIC_EMAIL_DOMAIN. (events@ and noreply@ senders are built in code from the same domain.)
EMAIL_FROM="HOEP <info@hemoelpaso.org>"

# --- File storage (Cloudflare R2): event flyers and photos ---
# All five are REQUIRED: the server refuses to start without them, and a production build fails (src/lib/r2-config.ts).
# Server-only; never prefix them with NEXT_PUBLIC_. The bucket also needs a CORS rule allowing PUT (header
# content-type) from every origin that opens /admin, because the browser uploads straight to R2.
# The account id on its own (not a URL): Cloudflare dashboard > R2.
R2_ACCOUNT_ID=
# An R2 API token with read and write access to the bucket below.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL the bucket is served on (custom domain), starting with https://
R2_PUBLIC_URL=

# --- Phone system (Twilio): src/lib/twilio/. Setup steps: docs/overhaul/TWILIO_SETUP.md ---
# Server-only; never prefix with NEXT_PUBLIC_. Without these the website runs normally and only /api/twilio/* fails.
# TWILIO_MODE decides whether anything can reach a real phone. Leave it UNSET almost always:
#   (unset)    production (VERCEL_ENV=production) -> "live"; everywhere else -> "capture"
#   capture    nothing rings and nothing is sent to Twilio.
#   allowlist  a DEVELOPMENT account: only numbers in TWILIO_DEV_ALLOWLIST can be rung.
#   live       the app REFUSES TO START with "live" unless VERCEL_ENV=production.
# TWILIO_MODE=
# TWILIO_DEV_ALLOWLIST=+19155550100
# Account SID and auth token of the account that owns the number (the token verifies webhook signatures).
# The production account is refused outside production (src/lib/twilio/production-account.ts).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# HOEP's Twilio number, e.g. +19155550100
TWILIO_PHONE_NUMBER=
# Optional (both or neither): an API key for REST calls instead of the auth token.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Optional: rung, with press-1 screening, ONLY when the routing settings can't be read. A US number, not HOEP's own.
TWILIO_FALLBACK_NUMBER=
# Local development only: the https address of your tunnel. Ignored in production.
# TWILIO_WEBHOOK_BASE_URL=https://example.trycloudflare.com
