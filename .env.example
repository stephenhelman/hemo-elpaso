# Copy to .env.local for development. Production values live in Vercel (Project > Settings > Environment Variables).
# Never commit real secrets.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://hemoelpaso.org

# --- Email (Resend) ---
RESEND_API_KEY=
# Domain of every org mailbox and every "from" address. MUST be the domain verified in Resend.
# Also the only domain the Email Routing settings accept. Default if unset: hemoelpaso.org
NEXT_PUBLIC_EMAIL_DOMAIN=hemoelpaso.org
# Sender for registration/household confirmations and the contact auto-reply. Required in production.
# Must be on NEXT_PUBLIC_EMAIL_DOMAIN. (events@ and noreply@ senders are built in code from the same domain.)
EMAIL_FROM="HOEP <info@hemoelpaso.org>"
